{
  "name": "sunshare-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build:contract": "cd contracts/sunshare-contract && cargo build --target wasm32-unknown-unknown --release",
    "build:server": "npm run build -w server",
    "build:client": "npm run build -w client",
    "build": "npm run build:server && npm run build:client",
    "test:contract": "cd contracts/sunshare-contract && cargo test",
    "test:server": "npm test -w server",
    "test:client": "npm test -w client",
    "test": "npm run test:contract && npm run test:server && npm run test:client"
  },
  "workspaces": [
    "server",
    "client"
  ]
}

